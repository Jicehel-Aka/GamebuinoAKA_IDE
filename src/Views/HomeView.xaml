<UserControl x:Class="GamebuinoAKA.IDE.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GamebuinoAKA.IDE.ViewModels"
             Background="{StaticResource BrushBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" Margin="40,32,40,32" HorizontalAlignment="Left">

            <!-- Hero -->
            <StackPanel Margin="0,0,0,32">
                <TextBlock Text="Gamebuino AKA IDE"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccent}"/>
                <TextBlock Text="Environnement de développement pour ESP32-S3 (320×240)"
                           FontSize="14"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Quick Actions -->
            <TextBlock Text="Actions rapides"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushText}"
                       Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NewProjectCommand}"
                        Content="➕  Nouveau projet"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenProjectCommand}"
                        Content="📂  Ouvrir projet"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CloneFromGitHubCommand}"
                        Content="⬇  Cloner GitHub"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenSettingsCommand}"
                        Content="⚙️  Paramètres"/>
            </StackPanel>

            <!-- Recent Projects -->
            <TextBlock Text="Projets récents"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushText}"
                       Margin="0,0,0,12"/>

            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="20">
                <TextBlock Text="Chargement..." Foreground="{StaticResource BrushTextMuted}"/>
            </Border>

            <ItemsControl ItemsSource="{Binding RecentProjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="16,12" Margin="0,0,0,8"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenRecentProjectCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Text="{Binding FolderPath}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Template}"
                                               FontSize="11" Padding="6,2"
                                               Foreground="{StaticResource BrushAccent}"
                                               Background="{StaticResource BrushAccentMuted}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LastModified, StringFormat='dd/MM/yyyy'}"
                                               FontSize="10"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Visibility="{Binding RecentProjects.Count,
                           Converter={StaticResource ZeroToVisibilityConverter}}"
                       Text="Aucun projet récent. Créez votre premier projet !"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontStyle="Italic" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
