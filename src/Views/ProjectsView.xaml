<UserControl x:Class="GamebuinoAKA.IDE.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Clone Dialog Overlay ─────────────────────────────────────────── -->
        <Grid Grid.RowSpan="3"
              Background="#AA000000" Panel.ZIndex="100"
              Visibility="{Binding ShowCloneDialog,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="28,24" MaxWidth="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Cloner depuis GitHub"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="URL du dépôt GitHub" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CloneUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Margin="0,4,0,16"/>

                    <TextBlock Text="Nom du dossier (laisser vide = auto)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CloneFolderName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Margin="0,4,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CloneFromGitHubCommand}"
                                Content="⬇  Cloner"
                                Margin="0,0,12,0"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelCloneCommand}"
                                Content="Annuler"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBoxStyle}"
                         MaxWidth="320" HorizontalAlignment="Left"
                         Tag="🔍 Rechercher un projet..."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="🔄  Actualiser"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ShowCloneCommand}"
                            Content="⬇  Cloner GitHub"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NewProjectNavigateCommand}"
                            Content="➕  Nouveau"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Projects List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- Loading -->
                <TextBlock Text="Chargement des projets..."
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,16,0,0"
                           Visibility="{Binding IsLoading,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding FilteredProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Project info -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Text="{Binding FolderPath}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Meta -->
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding BuildSystemLabel}"
                                                       FontSize="11" Padding="6,2" Margin="0,0,6,0"
                                                       Foreground="{StaticResource BrushText}"
                                                       Background="{StaticResource BrushBorder}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="↔"
                                                    ToolTip="Changer la chaîne (PlatformIO / ESP-IDF)"
                                                    FontSize="11" Padding="6,1"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.ToggleBuildSystemCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Template}"
                                                   FontSize="11" Padding="6,2"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   Background="{StaticResource BrushAccentMuted}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding LastModified, StringFormat='Modifié le dd/MM/yyyy'}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.OpenInVSCodeCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="📝 VS Code"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.BuildCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="🔨 Build"
                                                IsEnabled="{Binding DataContext.IsBusy,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                    Converter={StaticResource InverseBoolConverter}}"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.FlashCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="⚡ Flash"
                                                IsEnabled="{Binding DataContext.IsBusy,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                    Converter={StaticResource InverseBoolConverter}}"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.MonitorCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="📡 Monitor"
                                                IsEnabled="{Binding DataContext.IsBusy,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                    Converter={StaticResource InverseBoolConverter}}"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.OpenInExplorerCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="📂 Explorer"
                                                Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.DeleteProjectCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="🗑 Supprimer"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Visibility="{Binding FilteredProjects.Count,
                               Converter={StaticResource ZeroToVisibilityConverter}}"
                           Text="Aucun projet trouvé dans le workspace."
                           Foreground="{StaticResource BrushTextMuted}"
                           FontStyle="Italic" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Output Panel -->
        <Border Grid.Row="2"
                Background="#0D0D1A"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                MaxHeight="200"
                Visibility="{Binding ShowOutput, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,4"
                        Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Sortie"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding CancelOperationCommand}"
                                Content="✖ Annuler"
                                Visibility="{Binding IsBusy,
                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding OutputLog}"
                               Foreground="#A8FF78"
                               FontFamily="Consolas" FontSize="12"
                               Margin="12,8" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
