<UserControl x:Class="GamebuinoAKA.IDE.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="40,32" HorizontalAlignment="Left">

            <TextBlock Text="Paramètres" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BrushText}" Margin="0,0,0,24"/>

            <!-- Workspace -->
            <TextBlock Text="Workspace" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Dossier des projets" Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding WorkspaceFolder, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseWorkspaceFolderCommand}"
                        Content="Parcourir"/>
            </Grid>

            <!-- PlatformIO -->
            <TextBlock Text="PlatformIO" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Chemin vers pio.exe (optionnel – laissez vide pour utiliser le PATH)"
                       Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding PlatformIOPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowsePlatformIOCommand}"
                        Content="Parcourir"/>
            </Grid>
            <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,16">
                <Run Text="Version détectée : "/>
                <Run Text="{Binding DetectedPioVersion}" Foreground="{StaticResource BrushAccent}"/>
            </TextBlock>

            <!-- VS Code -->
            <TextBlock Text="VS Code" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Chemin vers Code.exe (optionnel)"
                       Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding VSCodePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseVSCodeCommand}"
                        Content="Parcourir"/>
            </Grid>

            <!-- Gamebuino lib -->
            <TextBlock Text="Bibliothèque Gamebuino AKA" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="URL du dépôt (lib_deps)" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding GamebuinoLibRepoUrl, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormTextBoxStyle}" Margin="0,4,0,16"/>

            <!-- ESP-IDF -->
            <TextBlock Text="ESP-IDF" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Script d'environnement (export.bat) — recommandé pour build/flash"
                       Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding IdfExportScript, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseIdfExportScriptCommand}" Content="Parcourir"/>
            </Grid>

            <TextBlock Text="Chemin vers idf.py (optionnel si export.bat renseigné ou idf.py dans le PATH)"
                       Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding IdfPyPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseIdfPyCommand}" Content="Parcourir"/>
            </Grid>

            <TextBlock Text="Port série pour flash/monitor (ex. COM5 — vide = auto)"
                       Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding IdfSerialPort, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormTextBoxStyle}" Margin="0,4,0,8" MaxWidth="160"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Composant components/gamebuino de référence (copié dans les nouveaux projets ESP-IDF)"
                       Style="{StaticResource FieldLabelStyle}"/>
            <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ReferenceGamebuinoComponentPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BrowseReferenceComponentCommand}" Content="Parcourir"/>
            </Grid>

            <!-- Chaîne de build par défaut -->
            <TextBlock Text="Chaîne de build par défaut" Style="{StaticResource SectionHeaderStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                <RadioButton Content="ESP-IDF" IsChecked="{Binding IsDefaultEspIdf}"
                             Style="{StaticResource RadioTemplateStyle}" Margin="0,0,12,0"/>
                <RadioButton Content="PlatformIO" IsChecked="{Binding IsDefaultPlatformIO}"
                             Style="{StaticResource RadioTemplateStyle}"/>
            </StackPanel>

            <!-- Format couleur des assets -->
            <TextBlock Text="Format couleur des assets" Style="{StaticResource SectionHeaderStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                <RadioButton Content="BGR565 (ordre lib AKA — recommandé)" IsChecked="{Binding IsColorBgrAka}"
                             Style="{StaticResource RadioTemplateStyle}" Margin="0,0,12,0"/>
                <RadioButton Content="RGB565 standard" IsChecked="{Binding IsColorRgbStd}"
                             Style="{StaticResource RadioTemplateStyle}"/>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Text="La lib AKA (lcd_color_rgb / graphics_make_color) empaquette en BGR565 : rouge en bits bas, bleu en bits hauts. Garder BGR565 évite l'inversion rouge/bleu à l'écran."/>
            <TextBlock Text="Couleur-clé de transparence (hex)" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding DefaultTransparentKeyHex, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormTextBoxStyle}" Margin="0,4,0,24" MaxWidth="160"
                     HorizontalAlignment="Left"/>

            <!-- Journal -->
            <TextBlock Text="Journal (logs)" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="{Binding LogFilePath}" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                       Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenLogFolderCommand}"
                        Content="📂 Ouvrir le dossier" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DeleteLogCommand}"
                        Content="🗑 Supprimer le journal"/>
            </StackPanel>

            <!-- Theme -->
            <TextBlock Text="Thème" Style="{StaticResource SectionHeaderStyle}"/>
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding Theme}"
                      Style="{StaticResource ComboBoxStyle}"
                      Margin="0,4,0,24"/>

            <!-- Status message -->
            <Border Padding="12,8" CornerRadius="4" Margin="0,0,0,16"
                    Background="{StaticResource BrushSurface}"
                    Visibility="{Binding StatusMessage,
                        Converter={StaticResource NotEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushText}" FontSize="13"/>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Content="💾  Enregistrer"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AutoDetectCommand}"
                        Content="🔍  Auto-détecter les outils"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetCommand}"
                        Content="↺  Réinitialiser"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
