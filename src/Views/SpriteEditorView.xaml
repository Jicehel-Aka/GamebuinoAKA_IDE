<UserControl x:Class="GamebuinoAKA.IDE.Views.SpriteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GamebuinoAKA.IDE.Controls"
             Background="{StaticResource BrushBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Tools & Palette -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0" Padding="12">
            <StackPanel>
                <TextBlock Text="Outils" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Import -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ImportImageCommand}"
                        Content="📂 Importer image"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ImportSpritesheetCommand}"
                        Content="🗂 Importer spritesheet"
                        HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <!-- Zoom -->
                <TextBlock Text="Zoom" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding ZoomLevels}"
                          SelectedItem="{Binding Zoom}"
                          Style="{StaticResource ComboBoxStyle}"
                          Margin="0,0,0,16"/>

                <!-- Palette -->
                <TextBlock Text="Palette (16 couleurs)" Style="{StaticResource FieldLabelStyle}"/>
                <ItemsControl ItemsSource="{Binding Palette}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="40" Height="40" Margin="2"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1" Cursor="Hand">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding .,
                                        Converter={StaticResource Rgb565ToColorConverter}}"/>
                                </Border.Background>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectColorCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Selected color preview -->
                <TextBlock Text="Couleur sélectionnée" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/>
                <Border Height="32" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding SelectedColor,
                            Converter={StaticResource Rgb565ToColorConverter}}"/>
                    </Border.Background>
                </Border>

                <!-- Export -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ExportCodeCommand}"
                        Content="💾 Exporter C++"
                        HorizontalAlignment="Stretch" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- Center: Canvas -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="12,8"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
            </Border>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <controls:PixelCanvas x:Name="PixelCanvas"
                                      SpriteSource="{Binding PreviewBitmap}"
                                      Zoom="{Binding Zoom}"
                                      PaintCommand="{Binding PaintPixelRelayCommand}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="20"/>
            </ScrollViewer>
        </Grid>

        <!-- Right: Exported code -->
        <Border Grid.Column="2"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,8"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Code C++ généré"
                               Foreground="{StaticResource BrushText}"
                               FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ExportedCode, Mode=OneWay}"
                             FontFamily="Consolas" FontSize="11"
                             Foreground="#A8FF78" Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True" TextWrapping="NoWrap"
                             Padding="12,8"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
