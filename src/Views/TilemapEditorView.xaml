<UserControl x:Class="GamebuinoAKA.IDE.Views.TilemapEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GamebuinoAKA.IDE.Controls"
             Background="{StaticResource BrushBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Tileset + config -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="Tileset" Style="{StaticResource SectionHeaderStyle}"/>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ImportTilesetCommand}"
                            Content="📂 Importer tileset"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                    <!-- Tileset preview -->
                    <Border BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" Margin="0,0,0,12"
                            Visibility="{Binding TilesetBitmap,
                                Converter={StaticResource NotNullToVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="200">
                            <controls:TilemapGrid
                                TilesetSource="{Binding TilesetBitmap}"
                                TileWidth="{Binding TileWidth}"
                                TileHeight="{Binding TileHeight}"
                                SelectTileCommand="{Binding SelectTileCommand}"
                                SelectedTileIndex="{Binding SelectedTileIndex}"/>
                        </ScrollViewer>
                    </Border>

                    <Separator Margin="0,8"/>

                    <!-- Map config -->
                    <TextBlock Text="Dimensions de la map" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Colonnes" FontSize="10"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBox Text="{Binding MapColumns, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Bottom"
                                   Margin="6,0,6,8" Foreground="{StaticResource BrushTextMuted}"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lignes" FontSize="10"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBox Text="{Binding MapRows, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tuile W" FontSize="10"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBox Text="{Binding TileWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Bottom"
                                   Margin="6,0,6,8" Foreground="{StaticResource BrushTextMuted}"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tuile H" FontSize="10"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                            <TextBox Text="{Binding TileHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ApplyMapSizeCommand}"
                            Content="✅ Appliquer"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0"/>

                    <!-- Layer selector -->
                    <TextBlock Text="Couche active" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding LayerNames}"
                              SelectedIndex="{Binding ActiveLayer}"
                              Style="{StaticResource ComboBoxStyle}"/>

                    <!-- Export -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExportCodeCommand}"
                            Content="💾 Exporter C++"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Center: Map canvas -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="12,8"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
            </Border>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <controls:TilemapGrid
                    MapPreviewSource="{Binding MapPreviewBitmap}"
                    TileWidth="{Binding TileWidth}"
                    TileHeight="{Binding TileHeight}"
                    MapColumns="{Binding MapColumns}"
                    MapRows="{Binding MapRows}"
                    PaintTileCommand="{Binding PaintTileRelayCommand}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16"/>
            </ScrollViewer>
        </Grid>

        <!-- Right: Exported code -->
        <Border Grid.Column="2"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,8"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Code C++ généré"
                               Foreground="{StaticResource BrushText}"
                               FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ExportedCode, Mode=OneWay}"
                             FontFamily="Consolas" FontSize="11"
                             Foreground="#A8FF78" Background="Transparent"
                             BorderThickness="0" IsReadOnly="True"
                             TextWrapping="NoWrap" Padding="12,8"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
